<?xml version="1.0" encoding="UTF-8"?>

<?import com.inventario.ui.Icono?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" spacing="10" styleClass="vista" xmlns="http://javafx.com/javafx/24"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inventario.ui.ControladorUsuarios">

    <padding>
        <Insets bottom="16" left="18" right="18" top="16"/>
    </padding>

    <Label styleClass="titulo-vista" text="Usuarios del sistema"/>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="campoBusqueda" onKeyReleased="#buscar" prefWidth="240"
                   promptText="Buscar usuario..."/>
        <Button onAction="#buscar" text="Buscar">
            <graphic><Icono nombre="buscar"/></graphic>
        </Button>
    </HBox>

    <!-- Fila de acciones aparte: con los iconos no caben en una sola linea. -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#nuevo" styleClass="boton-primario" text="Nuevo usuario">
            <graphic><Icono nombre="mas"/></graphic>
        </Button>
        <Button onAction="#editar" text="Editar">
            <graphic><Icono nombre="editar"/></graphic>
        </Button>
        <Button onAction="#activarDesactivar" text="Activar / Desactivar">
            <graphic><Icono nombre="check"/></graphic>
        </Button>
        <Button onAction="#actualizar" text="Actualizar">
            <graphic><Icono nombre="actualizar"/></graphic>
        </Button>
    </HBox>

    <TableView fx:id="tabla" prefHeight="400" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUsuario" prefWidth="150" text="Usuario"/>
            <TableColumn fx:id="colNombre" prefWidth="260" text="Nombre completo"/>
            <TableColumn fx:id="colRol" prefWidth="150" text="Rol"/>
            <TableColumn fx:id="colEstado" prefWidth="110" text="Estado"/>
            <TableColumn fx:id="colRegistro" prefWidth="160" text="Alta"/>
        </columns>
    </TableView>

    <Label fx:id="etiquetaContador" styleClass="etiqueta-suave" text="0 usuarios"/>
</VBox>
