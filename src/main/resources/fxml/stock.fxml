<?xml version="1.0" encoding="UTF-8"?>

<?import com.inventario.ui.Icono?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" spacing="10" styleClass="vista" xmlns="http://javafx.com/javafx/24"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inventario.ui.ControladorStock">

    <padding>
        <Insets bottom="16" left="18" right="18" top="16"/>
    </padding>

    <Label styleClass="titulo-vista" text="Entradas y salidas de stock"/>

    <VBox spacing="8" styleClass="tarjeta">
        <padding>
            <Insets bottom="12" left="12" right="12" top="12"/>
        </padding>

        <Label styleClass="subtitulo-vista" text="Registrar movimiento"/>
        <!-- Fila 1: producto, tipo y cantidad -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Producto:"/>
            <ComboBox fx:id="comboProducto" prefWidth="260"/>
            <Label text="Tipo:"/>
            <ComboBox fx:id="comboTipo" prefWidth="110"/>
            <Label fx:id="etiquetaCantidad" text="Cantidad:"/>
            <TextField fx:id="campoCantidad" prefWidth="90" promptText="0"/>
        </HBox>

        <!-- Fila 2: motivo y boton de registro (en una sola linea no cabia) -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Motivo:"/>
            <TextField fx:id="campoMotivo" onAction="#registrar" prefWidth="300"
                       HBox.hgrow="ALWAYS" promptText="Compra, venta, merma..."/>
            <Button onAction="#registrar" styleClass="boton-primario" text="Registrar">
                <graphic><Icono nombre="mas"/></graphic>
            </Button>
        </HBox>
        <Label fx:id="etiquetaStockActual" styleClass="etiqueta-suave" text="Selecciona un producto"/>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="campoBusqueda" onKeyReleased="#buscar" prefWidth="260"
                   promptText="Buscar movimiento..."/>
        <Button onAction="#buscar" text="Buscar">
            <graphic><Icono nombre="buscar"/></graphic>
        </Button>
        <Label text="Tipo:"/>
        <ComboBox fx:id="comboTipoFiltro" onAction="#filtrar" prefWidth="130"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#actualizar" text="Actualizar">
            <graphic><Icono nombre="actualizar"/></graphic>
        </Button>
    </HBox>

    <TableView fx:id="tabla" prefHeight="340" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" prefWidth="140" text="Fecha"/>
            <TableColumn fx:id="colTipo" prefWidth="95" text="Tipo"/>
            <TableColumn fx:id="colProducto" prefWidth="250" text="Producto"/>
            <TableColumn fx:id="colCantidad" prefWidth="90" text="Cantidad"/>
            <TableColumn fx:id="colAnterior" prefWidth="110" text="Stock anterior"/>
            <TableColumn fx:id="colResultante" prefWidth="130" text="Stock resultante"/>
            <TableColumn fx:id="colMotivo" prefWidth="240" text="Motivo"/>
            <TableColumn fx:id="colUsuario" prefWidth="150" text="Usuario"/>
        </columns>
    </TableView>

    <Label fx:id="etiquetaContador" styleClass="etiqueta-suave" text="0 movimientos"/>
</VBox>
