<?xml version="1.0" encoding="UTF-8"?>

<?import com.inventario.ui.Icono?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.inventario.ui.ControladorPrincipal">

    <top>
        <VBox styleClass="barra-superior">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="barra-usuario">
                <padding>
                    <Insets bottom="10" left="16" right="16" top="12"/>
                </padding>
                <Label styleClass="titulo-app" text="SISTEMA DE INVENTARIO DE MERCADERIA">
                    <graphic>
                        <Icono nombre="caja" tamano="22"/>
                    </graphic>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="etiquetaUsuario" styleClass="etiqueta-usuario" text="Usuario"/>
                <Label fx:id="etiquetaModo" styleClass="etiqueta-modo" text="JSON"/>
                <Button onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesion">
                    <graphic>
                        <Icono nombre="salir"/>
                    </graphic>
                </Button>
            </HBox>
            <Separator/>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="230" spacing="4" styleClass="menu-lateral">
            <padding>
                <Insets bottom="12" left="10" right="10" top="12"/>
            </padding>

            <Button fx:id="btnResumen" alignment="CENTER_LEFT" onAction="#irResumen"
                    styleClass="boton-menu" text="Resumen">
                <graphic><Icono nombre="panel"/></graphic>
            </Button>
            <Button fx:id="btnProductos" alignment="CENTER_LEFT" onAction="#irProductos"
                    styleClass="boton-menu" text="Productos">
                <graphic><Icono nombre="caja"/></graphic>
            </Button>
            <Button fx:id="btnStock" alignment="CENTER_LEFT" onAction="#irStock"
                    styleClass="boton-menu" text="Entradas y salidas">
                <graphic><Icono nombre="intercambio"/></graphic>
            </Button>
            <Button fx:id="btnCategorias" alignment="CENTER_LEFT" onAction="#irCategorias"
                    styleClass="boton-menu" text="Categorias">
                <graphic><Icono nombre="etiqueta"/></graphic>
            </Button>
            <Button fx:id="btnProveedores" alignment="CENTER_LEFT" onAction="#irProveedores"
                    styleClass="boton-menu" text="Proveedores">
                <graphic><Icono nombre="camion"/></graphic>
            </Button>
            <Button fx:id="btnReportes" alignment="CENTER_LEFT" onAction="#irReportes"
                    styleClass="boton-menu" text="Reportes (PDF / Excel)">
                <graphic><Icono nombre="grafica"/></graphic>
            </Button>
            <Button fx:id="btnUsuarios" alignment="CENTER_LEFT" onAction="#irUsuarios"
                    styleClass="boton-menu" text="Usuarios">
                <graphic><Icono nombre="grupo"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>
            <Button fx:id="btnMigrar" maxWidth="Infinity" onAction="#migrar"
                    styleClass="boton-migrar" text="Migrar JSON -&gt; MySQL">
                <graphic><Icono nombre="datos"/></graphic>
            </Button>
            <Label fx:id="etiquetaRuta" styleClass="etiqueta-ruta" text="" wrapText="true"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="panelContenido" styleClass="panel-contenido"/>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barra-inferior">
            <padding>
                <Insets bottom="8" left="16" right="16" top="8"/>
            </padding>
            <Label fx:id="etiquetaEstado" text="Listo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="etiqueta-pie"
                   text="El inventario se guarda en archivos .json por carpetas y puede migrarse a MySQL"/>
        </HBox>
    </bottom>
</BorderPane>
