<?xml version="1.0" encoding="UTF-8"?>

<?import com.inventario.ui.Icono?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" spacing="10" styleClass="vista" xmlns="http://javafx.com/javafx/24"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.inventario.ui.ControladorCategorias">

    <padding>
        <Insets bottom="16" left="18" right="18" top="16"/>
    </padding>

    <Label styleClass="titulo-vista" text="Categorias"/>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="campoBusqueda" onKeyReleased="#buscar" prefWidth="240"
                   promptText="Buscar categoria..."/>
        <Button onAction="#buscar" text="Buscar">
            <graphic><Icono nombre="buscar"/></graphic>
        </Button>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#nueva" styleClass="boton-primario" text="Nueva categoria">
            <graphic><Icono nombre="mas"/></graphic>
        </Button>
        <Button onAction="#editar" text="Editar">
            <graphic><Icono nombre="editar"/></graphic>
        </Button>
        <Button onAction="#eliminar" styleClass="boton-peligro" text="Eliminar">
            <graphic><Icono nombre="borrar"/></graphic>
        </Button>
        <Button onAction="#actualizar" text="Actualizar">
            <graphic><Icono nombre="actualizar"/></graphic>
        </Button>
    </HBox>

    <TableView fx:id="tabla" prefHeight="420" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="70" text="ID"/>
            <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre"/>
            <TableColumn fx:id="colDescripcion" prefWidth="460" text="Descripcion"/>
            <TableColumn fx:id="colProductos" prefWidth="130" text="Productos"/>
        </columns>
    </TableView>

    <Label fx:id="etiquetaContador" styleClass="etiqueta-suave" text="0 categorias"/>
</VBox>
